# Copy to .env and fill in. .env is not committed.

# Model providers
MODEL_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# HTTP server
PORT=3000

# Postgres (compose.yaml and the server)
# 127.0.0.1, not localhost: localhost resolves to IPv6 ::1 first, and compose.yaml
# publishes the port on IPv4 only.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=dnd
POSTGRES_PASSWORD=
POSTGRES_DB=dnd
