{
  "name": "@dnd/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --conditions=source --env-file=../../.env src/index.ts",
    "test": "tsx --conditions=source --test \"src/**/*.test.ts\"",
    "play": "tsx --conditions=source --env-file=../../.env src/cli/play.ts",
    "build:shared": "npm run build -w @dnd/shared",
    "prestart": "npm run build:shared",
    "start": "nest start --env-file=../../.env",
    "prestart:dev": "npm run build:shared",
    "start:dev": "nest start --watch --env-file=../../.env",
    "prebuild": "npm run build:shared",
    "build": "nest build"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/swagger": "^12.1.3",
    "@nestjs/typeorm": "^12.0.3",
    "groq-sdk": "^1.6.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22"
  }
}
